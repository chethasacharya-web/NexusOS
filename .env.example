# Docker Compose defaults
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_local_password
POSTGRES_DB=nexusos
DATABASE_URL=postgresql://nexus:nexus_local_password@db:5432/nexusos
JWT_SECRET=replace_this_with_a_long_random_secret
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional AWS S3 uploads (leave blank to keep upload integration disabled)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
